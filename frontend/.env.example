# Copy to frontend/.env.local. Empty configuration keeps sign-in disabled.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional client ID from the same Privy application.
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# WalletConnect Project ID for mobile wallet QR codes (from cloud.reown.com or Privy dashboard)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Server-only ES256 public verification key. Literal \n separators are supported.
PRIVY_VERIFICATION_KEY=
# Server-only vault master key: optional base64-encoded 32 bytes. Local development
# generates an ignored .workbench-state/vault/master.key if this is empty.
JANUS_VAULT_KEY=
# Optional absolute monorepo root and persistent private state directory.
JANUS_WORKSPACE_ROOT=
JANUS_WORKBENCH_STATE_DIR=
# Public, origin-restricted Arkiv RPC access key. Never put an LLM key here.
NEXT_PUBLIC_ARKIV_ACCESS_KEY=

# Standalone local stack (Compose sets these automatically).
NEXT_PUBLIC_JANUS_RPC_PORT=
JANUS_RPC_PORT=
JANUS_RPC_URL=
JANUS_MERCHANT_URL=
