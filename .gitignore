# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
._*

# Nested package dependencies and generated output
**/node_modules/
**/.npm-cache/

**/.next/
**/coverage/
**/out/
**/build/
**/.env*

# Commit only secret-free configuration templates
!**/.env.example
!**/.env.*.example

# Local compiler output
**/artifacts/
**/.lockbuild/

# Durable merchant/runner state (never delete while outcomes are unknown)
**/.merchant-state/
**/.runner-state/
**/.paper-state/
**/.workbench-state/
/.tools/
/.security-artifacts/

# Reproducible standalone recovery assets, generated before frontend dev/build
/frontend/public/recovery/

# Browser recording intermediates; explicitly named reviewer videos are source evidence.
**/page@*.webm
