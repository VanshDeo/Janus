# Copy to backend/.env.hedera for dedicated TESTNET use only.
# Alternatively, npm run hedera:init in backend generates dedicated keys.
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
HEDERA_TOKEN_ID=0.0.429274
HEDERA_OWNER_PRIVATE_KEY=
HEDERA_WORKER_PRIVATE_KEY=
HEDERA_MERCHANT_PRIVATE_KEY=

# Official native x402 proof (separate from the task-treasury executor adapter).
# Create/fund two dedicated Hedera TESTNET ECDSA accounts at portal.hedera.com.
# Private keys: raw ECDSA hex with 0x prefix, or SDK DER-encoded private keys.
# Merchant can equal the facilitator; it must differ from the payer.
HEDERA_X402_PAYER_ACCOUNT_ID=
HEDERA_X402_PAYER_PRIVATE_KEY=
HEDERA_X402_FEE_PAYER_ACCOUNT_ID=
HEDERA_X402_FEE_PAYER_PRIVATE_KEY=
HEDERA_X402_MERCHANT_ACCOUNT_ID=
# 10,000 tinybars = 0.0001 test HBAR. Change asset only with matching decimals.
HEDERA_X402_ASSET=0.0.0
HEDERA_X402_AMOUNT=10000
