# Optional: copy to .env; Compose also reads exported environment variables.
JANUS_FRONTEND_PORT=3000
JANUS_BACKEND_PORT=4023
JANUS_RPC_PORT=8545
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Server-only public ES256 verification key; never the Privy app secret.
PRIVY_VERIFICATION_KEY=

# Optional provider vault key (32 bytes encoded as base64).
JANUS_VAULT_KEY=
# Optional dedicated, funded Rabdi test wallet for live worker replacement.
ARKIV_WRITER_PRIVATE_KEY=
ARKIV_ACCESS_KEY=
